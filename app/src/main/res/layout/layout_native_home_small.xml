<?xml version="1.0" encoding="utf-8"?>
<!--
    AdMob native ad layout — compact "small" style for home feed placements.

    Rules enforced here:
    1. NativeAdView is the single root — all asset views live inside it.
    2. MediaView must be >= 120x120dp (AdMob validator measures declared size,
       even for invisible views). We keep it invisible and tucked at 0,0 with
       a 0dp elevation so it never overlaps visible content.
    3. No asset view may be positioned so its bounds escape the NativeAdView.
       adAttribution is anchored strictly inside the icon/headline row.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">

    <!--
        Visible card — every user-facing asset lives here.
        bg_native_ads provides the light-grey rounded card background.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ad_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_ads"
        android:padding="12dp"
        android:layoutDirection="ltr"
        tools:ignore="HardcodedText,SpUsage">

        <!-- ── Row 1: app icon ──────────────────────────────────────────── -->

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- "Ads" badge — top-start of text column, vertically centred with icon top -->
        <TextView
            android:id="@+id/adAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ad_icon"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Ads"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon" />

        <!-- Headline — right of badge, top-aligned with badge -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/adAttribution"
            app:layout_constraintTop_toTopOf="@id/adAttribution"
            tools:text="Unlock Caller Details New" />

        <!-- Advertiser — below headline, aligned with headline start/end -->
        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/ad_headline"
            app:layout_constraintStart_toStartOf="@id/ad_headline"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            tools:text="ClarityCheck" />

        <!-- ── Row 2: body text ──────────────────────────────────────────── -->

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#555555"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_app_icon"
            tools:text="Reverse Phone Lookup for names, addresses, and social profiles in seconds." />

        <!-- ── CTA button ────────────────────────────────────────────────── -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_native_home_cta"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_body"
            tools:text="OPEN" />

        <!-- ── Hidden required asset stubs ──────────────────────────────── -->

        <TextView
            android:id="@+id/ad_price"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RatingBar
            android:id="@+id/ad_stars"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            MediaView — AdMob validator measures declared layout size regardless
            of visibility. Must be >= 120x120dp.
            Set invisible (not gone) so it occupies real space while hidden,
            and positioned at parent start/top so it stays strictly inside
            the NativeAdView boundary. elevation=0 ensures it never draws
            over content.
        -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:visibility="invisible"
            android:elevation="0dp"
            android:alpha="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
