<?xml version="1.0" encoding="utf-8"?>
<!--
    AdMob native ad layout — medium style for home Popular tab placement.
    
    Design: Dark background with visible MediaView on the right side,
    matching the app's dark theme with Pink CTA button.
    
    Rules enforced:
    1. NativeAdView is the single root — all asset views live inside it.
    2. MediaView must be >= 120x120dp and is visible on the right side.
    3. No asset view may be positioned so its bounds escape the NativeAdView.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">

    <!-- Dark card matching app theme -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_ads_dark"
        android:padding="12dp"
        android:layoutDirection="ltr"
        tools:ignore="HardcodedText,SpUsage">

        <!-- App icon -->
        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- "Ad" badge -->
        <TextView
            android:id="@+id/ad_icon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ad_icon_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Ad"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon" />

        <!-- Headline (Placed on the same line to the right of the Ad badge) -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineHeight="18sp"
            app:layout_constraintStart_toEndOf="@id/ad_icon_text"
            app:layout_constraintEnd_toStartOf="@id/ad_media"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon"
            tools:text="Start your crypto journey today!" />

        <!-- Advertiser -->
        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#4A9FFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ad_media"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            tools:text="Bybit: Buy Bitcoin and Crypto" />

        <!-- Body text -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:lineHeight="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ad_media"
            app:layout_constraintTop_toBottomOf="@id/ad_advertiser"
            tools:text="Ready to make your first crypto trade? Bybit is here to guide your every step! 🚀" />

        <!-- MediaView on right side -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- CTA button - FULL WIDTH at bottom -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_native_cta_dark"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_media"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Explore more" />

        <!-- Hidden required asset stubs -->
        <TextView
            android:id="@+id/adAttribution"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ad_price"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RatingBar
            android:id="@+id/ad_stars"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>