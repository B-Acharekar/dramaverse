<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark background for native ads matching app UI.
    Background: #16121A (app dark panel)
    Border: #1AFFFFFF (subtle white border)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="12dp" />
    
    <solid android:color="#16121A" />
    
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />

</shape>
